@model FerreteriaValdivia.Models.Producto

@{
    ViewData["Title"] = "Crear Producto";
}

<div class="container mt-4">
    <h2>➕ Agregar Nuevo Producto</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Crear" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="CodigoBarras" class="form-label">Código de Barras</label>
                    <input asp-for="CodigoBarras" class="form-control" required />
                    <span asp-validation-for="CodigoBarras" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label">Nombre del Producto</label>
                    <input asp-for="Nombre" class="form-control" required />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PrecioVenta" class="form-label">Precio de Venta (Bs.)</label>
                    <input asp-for="PrecioVenta" type="number" step="0.01" class="form-control" required />
                    <span asp-validation-for="PrecioVenta" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="StockMinimo" class="form-label">Stock Mínimo</label>
                    <input asp-for="StockMinimo" type="number" class="form-control" required />
                    <span asp-validation-for="StockMinimo" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="StockActual" class="form-label">Stock Actual</label>
                    <input asp-for="StockActual" type="number" class="form-control" required />
                    <span asp-validation-for="StockActual" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-success">Guardar Producto</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </form>
        </div>
    </div>
</div>