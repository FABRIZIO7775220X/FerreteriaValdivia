@{
    ViewData["Title"] = "Estadísticas";
}

<div class="container mt-4">
    <h2>📊 Reporte de Clientes</h2>
    <hr />

    <div class="row mt-4">
        <div class="col-md-4">
            <div class="card text-white bg-success mb-3 shadow">
                <div class="card-header font-weight-bold">Total de Clientes (COUNT)</div>
                <div class="card-body text-center">
                    <h1 class="display-4 font-weight-bold">@ViewBag.TotalClientes</h1>
                    <p class="card-text">Registrados en la base de datos.</p>
                </div>
            </div>
        </div>
    </div>
</div>