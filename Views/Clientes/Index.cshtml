@model IEnumerable<FerreteriaValdivia.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
}

<div class="container mt-2">
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="text-primary fw-bold mb-0">📋 Lista de Clientes</h2>
                <a asp-action="Crear" class="btn btn-success">➕ Agregar Nuevo Cliente</a>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Apellido</th>
                            <th>Teléfono</th>
                            <th>Email</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cliente in Model)
                        {
                            <tr>
                                <td class="fw-bold">@cliente.Id</td>
                                <td>@cliente.Nombre</td>
                                <td>@cliente.Apellido</td>
                                <td>@cliente.Telefono</td>
                                <td>@cliente.Email</td>
                                <td class="text-center">
                                    <a asp-action="Editar" asp-route-id="@cliente.Id" class="btn btn-warning btn-sm px-3">Editar</a>
                                    <a asp-action="Eliminar" asp-route-id="@cliente.Id" class="btn btn-danger btn-sm px-3" onclick="return confirm('¿Seguro que deseas eliminar este cliente?');">Eliminar</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>