@model IEnumerable<FerreteriaValdivia.Models.Cliente>

@{
    ViewData["Title"] = "Buscar Cliente";
}

<div class="container mt-4">
    <h2>Buscar Cliente</h2>

    <form asp-action="Buscar" method="get" class="row g-3 mb-4">
        <div class="col-auto">
            <input type="text" name="texto" class="form-control" placeholder="Escribe un nombre o apellido..." />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Buscar</button>
        </div>
        <div class="col-auto">
            <a asp-action="Index" class="btn btn-secondary">Ver Todos</a>
        </div>
    </form>

    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Teléfono</th>
                <th>Email</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var cliente in Model)
                {
                    <tr>
                        <td>@cliente.Id</td>
                        <td>@cliente.Nombre</td>
                        <td>@cliente.Apellido</td>
                        <td>@cliente.Telefono</td>
                        <td>@cliente.Email</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center">No se encontraron clientes que coincidan.</td>
                </tr>
            }
        </tbody>
    </table>
</div>