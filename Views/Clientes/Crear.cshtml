@model FerreteriaValdivia.Models.Cliente

@{
    ViewData["Title"] = "Agregar Cliente";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h2 class="text-success fw-bold mb-3 text-center">👤 Nuevo Cliente</h2>
                    <hr class="mb-4" />

                    <form asp-action="Crear" method="post">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Nombre</label>
                            <input asp-for="Nombre" class="form-control" placeholder="Ej. Carlos" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Apellido</label>
                            <input asp-for="Apellido" class="form-control" placeholder="Ej. Mendoza" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Teléfono</label>
                            <input asp-for="Telefono" class="form-control" placeholder="Ej. 70012345" />
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Email</label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="Ej. correo@gmail.com" />
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary px-4">Cancelar</a>
                            <button type="submit" class="btn btn-success px-4">Guardar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>