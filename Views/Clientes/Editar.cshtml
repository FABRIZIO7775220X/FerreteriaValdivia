@model FerreteriaValdivia.Models.Cliente
@{ ViewData["Title"] = "Editar"; }
<div class="container mt-4 col-md-6">
    <h2>Editar Cliente</h2>
    <form asp-action="Editar" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="mb-3"><label class="form-label">Nombre</label><input asp-for="Nombre" class="form-control" required /></div>
        <div class="mb-3"><label class="form-label">Apellido</label><input asp-for="Apellido" class="form-control" required /></div>
        <div class="mb-3"><label class="form-label">Teléfono</label><input asp-for="Telefono" class="form-control" /></div>
        <div class="mb-3"><label class="form-label">Email</label><input asp-for="Email" class="form-control" /></div>
        <button type="submit" class="btn btn-primary">Actualizar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>